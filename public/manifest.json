{
  "requestFramePermissions": [
    "camera",
    "geolocation"
  ],
  "majorCapabilities": [
    "MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API"
  ],
  "id": "/",
  "name": "NYC Ledger",
  "short_name": "NYC Ledger",
  "description": "NYC Ledger tracking and offline data exploration",
  "lang": "en",
  "start_url": "/",
  "scope": "/",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "display": "standalone",
  "orientation": "any",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#ffffff",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "categories": [
    "utilities",
    "productivity"
  ],
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "/",
      "name": "Ledger Data File",
      "icons": [
        {
          "src": "/assets/re-do logo/icon_512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "accept": {
        "text/csv": [
          ".csv"
        ],
        "application/json": [
          ".json"
        ]
      }
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+nycledger",
      "url": "/?data=%s"
    }
  ],
  "shortcuts": [
    {
      "name": "Open Home",
      "short_name": "Home",
      "description": "Navigate to NYC Ledger main view",
      "url": "/",
      "icons": [
        {
          "src": "/assets/re-do logo/icon_192.png",
          "sizes": "192x192"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "NYC Ledger Overview",
      "short_name": "Ledger Overview",
      "description": "Displays recent financial entries and ledger summaries",
      "tag": "nyc-ledger-summary",
      "template": "ledger-widget-template",
      "ms_ac_template": "/widgets/summary.json",
      "data": "/widgets/summary-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "/screenshots/widget-preview.png",
          "sizes": "600x400",
          "label": "Preview of the summary widget"
        }
      ],
      "icons": [
        {
          "src": "/assets/re-do logo/icon_512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "auth": false
    }
  ],
  "icons": [
    {
      "src": "/assets/re-do logo/icon_48.png",
      "sizes": "48x48",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_72.png",
      "sizes": "72x72",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_96.png",
      "sizes": "96x96",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_144.png",
      "sizes": "144x144",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/assets/re-do logo/icon_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/assets/re-do logo/icon_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-screen.png",
      "sizes": "1080x1920",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Mobile view of app home screen"
    },
    {
      "src": "/screenshots/desktop-screen.png",
      "sizes": "1920x1080",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Desktop view of app home screen"
    }
  ]
}